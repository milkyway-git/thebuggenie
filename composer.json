{
    "name" : "thebuggenie/thebuggenie",
    "description" : "The Bug Genie is a friendly project management and issue tracking tool",
    "authors" : [{
        "name" : "Daniel Andre Eikeland",
        "email" : "zegenie@gmail.com"
    }
    ],
    "support" : {
        "email" : "support@thebuggenie.com",
        "forum" : "http://forum.thebuggenie.org",
        "issues" : "https://issues.thebuggenie.com",
        "irc" : "irc://irc.freenode.org/thebuggenie"
    },
    "license" : [
        "MPL-2.0"
    ],
    "require" : {
        "php": "^7.4|^8.0",
        "thebuggenie/b2db" : "^3.0",
        "symfony/mailer" : "6.3.*",
        "webit/eval-math" : "^1.0",
        "mustangostang/spyc": "0.5.*",
        "phpoffice/phpspreadsheet": "^1.17.0",
        "assetic-php/assetic": "^3.0",
        "lib-pcre" : ">=8.0",
        "net/http" : "^1.1",
        "guzzlehttp/guzzle": "^6.3",
        "scrivo/highlight.php": "^9.0",
        "ramsey/uuid": "^4.6",
        "erusev/parsedown": "^1.7",
        "ext-gd" : "*",
        "ext-curl" : "*",
        "ext-PDO" : "*",
        "ext-iconv" : "*",
        "ext-json" : "*",
        "ext-mbstring" : "*",
        "ext-pcre" : "*",
        "ext-xml" : "*",
        "ext-Reflection" : "*",
        "ext-zip" : "*",
        "easybook/geshi": "^1.0.8.19",
        "league/html-to-markdown": "^4.8"
    },
    "require-dev" : {
        "symfony/finder" : "~6.2",
        "phpunit/phpunit": "~9"
    },
    "repositories" : [
        {
            "type": "package",
            "package": {
              "name": "milkyway-git/b2db",
              "version": "master",
              "source": {
                "url": "https://github.com/milkyway-git/b2db.git",
                "type": "git",
                "reference": "master"
              }
            }
        },
        {
            "type": "package",
            "package": {
              "name": "assetic-php/assetic",
              "version": "3.0.2",
              "source": {
                "url": "https://github.com/assetic-php/assetic.git",
                "type": "git",
                "reference": "master"
              }
            }
        }
    ],
    "suggest" : {
        "ext-apc" : "Enables APC caching of configuration files and table class definitions"
    },
    "autoload": {
        "psr-0": {
            "Assetic": ["vendor/assetic-php/assetic/src/"]
        },
        "psr-4": {
            "thebuggenie\\modules\\" : "modules/",
            "thebuggenie\\core\\" : "core/"
        },
        "files": [
            "vendor/assetic-php/assetic/src/functions.php"
            ],
        "classmap": [
            "vendor/phpunit/phpunit/src/"
            ]
    },
    "minimum-stability" : "dev",
    "prefer-stable" : true,
    "scripts": {
        "post-install-cmd": [
            "thebuggenie\\core\\modules\\installation\\controllers\\Main::createCacheFolder",
            "thebuggenie\\core\\modules\\installation\\controllers\\Main::checkAssetSymlink"
        ],
        "post-update-cmd": [
            "thebuggenie\\core\\modules\\installation\\controllers\\Main::createCacheFolder",
            "thebuggenie\\core\\modules\\installation\\controllers\\Main::checkAssetSymlink"
        ]
    }
}
